<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700"
            prefWidth="1200"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../styles/customer.css">

    <children>

        <!-- Left Product Area -->

        <AnchorPane prefWidth="850"
                    prefHeight="700"
                    styleClass="main-area">

            <children>

                <!-- Heading -->

                <Label layoutX="30"
                       layoutY="20"
                       text="Customer Shopping"
                       styleClass="heading"/>

                <!-- Search -->

                <TextField layoutX="30"
                           layoutY="80"
                           prefWidth="300"
                           prefHeight="40"
                           promptText="Search Products..."
                           styleClass="search-field"/>

                <!-- Product Grid -->

                <FlowPane layoutX="30"
                          layoutY="150"
                          hgap="20"
                          vgap="20"
                          prefWidth="760">

                    <children>

                        <!-- Product Card -->

                        <VBox prefWidth="180"
                              prefHeight="240"
                              styleClass="product-card">

                            <children>

                                <ImageView fitHeight="100"
                                           fitWidth="120"
                                           preserveRatio="true">

                                    <image>
                                        <Image url="/images/lays.png"/>
                                    </image>

                                </ImageView>

                                <Label text="Lays"
                                       styleClass="product-name"/>

                                <Label text="₹20"
                                       styleClass="product-price"/>

                                <Button text="Add"
                                        styleClass="cart-btn"/>

                            </children>

                        </VBox>

                        <!-- Product 2 -->

                        <VBox prefWidth="180"
                              prefHeight="240"
                              styleClass="product-card">

                            <children>

                                <ImageView fitHeight="100"
                                           fitWidth="120"
                                           preserveRatio="true">

                                    <image>
                                        <Image url="/images/eggs.png"/>
                                    </image>

                                </ImageView>

                                <Label text="Fresh Eggs"
                                       styleClass="product-name"/>

                                <Label text="₹40"
                                       styleClass="product-price"/>

                                <Button text="Add"
                                        styleClass="cart-btn"/>

                            </children>

                        </VBox>

                        <!-- Product 3 -->

                        <VBox prefWidth="180"
                            prefHeight="240"
                            styleClass="product-card">

                            <children>

                                <ImageView fitHeight="100"
                                        fitWidth="120"
                                        preserveRatio="true">

                                    <image>
                                        <Image url="/images/det.png"/>
                                    </image>

                                </ImageView>

                                <Label text="Detergent"
                                    styleClass="product-name"/>

                                <Label text="₹360"
                                    styleClass="product-price"/>

                                <Button text="Add"
                                        styleClass="cart-btn"/>

                            </children>

                        </VBox>

                        <!-- Product 4 -->

                        <VBox prefWidth="180"
                            prefHeight="240"
                            styleClass="product-card">

                            <children>

                                <ImageView fitHeight="100"
                                        fitWidth="120"
                                        preserveRatio="true">

                                    <image>
                                        <Image url="/images/joh.png"/>
                                    </image>

                                </ImageView>

                                <Label text="Baby Soap"
                                    styleClass="product-name"/>

                                <Label text="₹40"
                                    styleClass="product-price"/>

                                <Button text="Add"
                                        styleClass="cart-btn"/>

                            </children>

                        </VBox>

                        <!-- Product 5 -->

                        <VBox prefWidth="180"
                            prefHeight="240"
                            styleClass="product-card">

                            <children>

                                <ImageView fitHeight="100"
                                        fitWidth="120"
                                        preserveRatio="true">

                                    <image>
                                        <Image url="/images/cris.png"/>
                                    </image>

                                </ImageView>

                                <Label text="Crispello"
                                    styleClass="product-name"/>

                                <Label text="₹20"
                                    styleClass="product-price"/>

                                <Button text="Add"
                                        styleClass="cart-btn"/>

                            </children>

                        </VBox>

                        <!-- Product 6 -->

                        <VBox prefWidth="180"
                            prefHeight="240"
                            styleClass="product-card">

                            <children>

                                <ImageView fitHeight="100"
                                        fitWidth="120"
                                        preserveRatio="true">

                                    <image>
                                        <Image url="/images/pot.png"/>
                                    </image>

                                </ImageView>

                                <Label text="Potato"
                                    styleClass="product-name"/>

                                <Label text="₹30"
                                    styleClass="product-price"/>

                                <Button text="Add"
                                        styleClass="cart-btn"/>

                            </children>

                        </VBox>

                    </children>

                </FlowPane>

            </children>

        </AnchorPane>

        <!-- Right Cart Panel -->

        <VBox layoutX="850"
                AnchorPane.topAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                prefWidth="350"
                styleClass="cart-panel">

            <children>

                <Label text="Your Cart"
                       styleClass="cart-heading"/>

                <!-- Cart Items -->

                <VBox prefWidth="300"
                      prefHeight="450"
                      spacing="15">

                    <children>

                        <HBox spacing="20">

                            <children>

                                <Label text="Lays"/>

                                <Label text="x2"/>

                                <Label text="₹40"/>

                            </children>

                        </HBox>

                    </children>

                </VBox>

                <!-- Total -->

                <Label text="Total : ₹40"
                       styleClass="total-text"/>

                <!-- Checkout -->

                <Button text="Proceed To Payment"
                        styleClass="checkout-btn"/>

            </children>

        </VBox>

    </children>

</AnchorPane>